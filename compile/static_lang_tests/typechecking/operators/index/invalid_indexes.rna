struct MyStruct{}

fun test(ptr: char*, arr: char[4]) {
    let bool_ = true;
    let char_: char;
    let double_: double64 = 1.0;
    let float_: float32;
    let mystruct_: MyStruct;
    
    ptr[bool_]@unsafe;
    ptr[char_]@unsafe;
    ptr[double_]@unsafe;
    ptr[float_]@unsafe;
    ptr[mystruct_]@unsafe;
    
    arr[bool_];
    arr[char_];
    arr[double_];
    arr[float_];
    arr[mystruct_];
}