fun test() {
    let iarr: int[10];
    let iconstarr: int const[10];
    let iarrconst: int[10]const;

    let ip: int*;
    let iconstp: int const*;
    let ipconst: int*const;

    iarr[0];
    iconstarr[0];
    iarrconst[0];
    ip[0]@unsafe;
    iconstp[0]@unsafe;
    ipconst[0]@unsafe;

    let iarrarr: int[10][20];
    iarrarr[1][2];
    
    let ipp: int**;
    ipp[1]@unsafe[2]@unsafe;

    let iparr: int*[10];
    let iarrp: int[10]*;

    iparr[1][2]@unsafe;
    iarrp[1]@unsafe[2];
}