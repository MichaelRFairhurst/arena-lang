    s = -f; // E-T_ASGN_NOREL
    s = -d; // E-T_ASGN_NOREL
    us = -f; // E-T_ASGN_NOREL
    us = -d; // E-T_ASGN_NOREL

    i = -f; // E-T_ASGN_NOREL
    i = -d; // E-T_ASGN_NOREL
    ui = -f; // E-T_ASGN_NOREL
    ui = -d; // E-T_ASGN_NOREL

    l = -f; // E-T_ASGN_NOREL
    l = -d; // E-T_ASGN_NOREL
    ul = -f; // E-T_ASGN_NOREL
    ul = -d; // E-T_ASGN_NOREL

    sz = -f; // E-T_ASGN_NOREL
    sz = -d; // E-T_ASGN_NOREL
