fun zero() {
    let i: int = 0;
}

fun hex() {
    let i: int = 0x123;
}

fun binary() {
    let i: int = 0b101001;
}

fun oct() {
    let i: int = 8x644;
}

fun dec_quote_space() {
    let i: int = 123'345;
}

fun dec_under_space() {
    let i: int = 123_345;
}

fun hex_quote_space() {
    let i: int = 0xABC'DEF;
}

fun hex_under_space() {
    let i: int = 0xABC_DEF;
}

fun bad() {
    let b1: bool = 0; // E-T_NOT_INTGL
    let b2: bool = 1; // E-T_NOT_INTGL
    let b3: bool = 123; // E-T_NOT_INTGL
    let b4: bool = 0x123; // E-T_NOT_INTGL
    let b5: bool = 8x123; // E-T_NOT_INTGL
    let b6: bool = 0b01; // E-T_NOT_INTGL

    let d1: double64 = 1; // E-T_NOT_INTGL
    let c1: char const* = 1; // E-T_NOT_INTGL
    let c2: char = 1; // E-T_NOT_INTGL
}

fun int_max() {
    let i1: int = 0;
    let i2: int = 2'147'483'647;
    let i3: int = 2'147'483'648; // E-T_LIT_OOR
    let i4: int = -2'147'483'648;
    let i5: int = -2'147'483'649; // E-T_LIT_OOR

    let u1: uint = 0;
    let u2: uint = 4'294'967'295;
    let u3: uint = 4'294'967'296; // E-T_LIT_OOR
    let u4: uint = -1; // E-T_LIT_OOR
}

