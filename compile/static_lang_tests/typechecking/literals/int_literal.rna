    let us: uint = 18'446'744'073'709'551'616; // E-T_LIT_OOR
    let l: long = 18'446'744'073'709'551'616; // E-T_LIT_OOR
    let ul: ulong = 18'446'744'073'709'551'616; // E-T_LIT_OOR
}

fun overflow_128() {
    // Internally we use 128 bits so that we can check 64 bit overflow.
    // Check that we don't overflow 128 bits internally.

    let i_2to127m1: int = 170141183460469231731687303715884105727; // E-T_LIT_OOR
    let i_2to127: int = 170141183460469231731687303715884105728; // E-T_LIT_OOR
    let i_2to127p1: int = 170141183460469231731687303715884105729; // E-T_LIT_OOR
    let i_n2to127: int = -170141183460469231731687303715884105728; // E-T_LIT_OOR
    let i_n2to127p1: int = -170141183460469231731687303715884105729; // E-T_LIT_OOR

    let i_2to128m1: int = 340282366920938463463374607431768211455; // E-T_LIT_OOR
    let i_2to128: int = 340282366920938463463374607431768211456; // E-T_LIT_OOR
    let i_2to128p1: int = 340282366920938463463374607431768211457; // E-T_LIT_OOR
    let i_n2to128: int = -340282366920938463463374607431768211456; // E-T_LIT_OOR
    let i_n2to128p1: int = -340282366920938463463374607431768211457; // E-T_LIT_OOR
}