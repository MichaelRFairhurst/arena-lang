fun f() {
    let i_stack: int;

    // Chain of assignments of pointers to stack lifetime.
    // Each variable should be inferred to be `int *stack`.
    let p1 = i_stack.&;
    let p2 = p1;
    let p3 = p2;
    let p4 = p3;
    let p5: int *stack = p4; // OK
}

fun g() {
    let i_stack: int;

    // Chain of assignments of pointers to stack lifetime
    // Each variable should be inferred to be `int *stack`.
    let p1 = i_stack.&;
    let p2 = p1;
    let p3 = p2;
    let p4 = p3;

    // Address to i_stack escapes into static memory
    let p5: int *static = p4; // E-L_ESC_STACK
}

fun h() {
    let i_stack: int;

    // Chain of assignments of pointers to stack lifetime
    // Each variable declares a new "free" lifetime that we should solve to equal *stack.
    let p1: int* = i_stack.&;
    let p2: int* = p1;
    let p3: int* = p2;
    let p4: int* = p3;
    let p5: int *stack = p4; // OK
}

fun i() {
    let i_stack: int;

    // Chain of assignments of pointers to stack lifetime
    // Each variable declares a new "free" lifetime that we should solve to equal *stack.
    let p1: int* = i_stack.&;
    let p2: int* = p1;
    let p3: int* = p2;
    let p4: int* = p3;

    // Assignment leaks address of i_stack into static memory
    let p5: int *static = p4; // E-L_ESC_STACK
}

fun h() {
    let i_stack: int;

    // Chain of assignments of pointers to stack lifetime
    // Each variable declares a lifetime that we should solve to equal *stack.
    let p1: int *a = i_stack.&;
    let p2: int *b = p1;
    let p3: int *c = p2;
    let p4: int *d = p3;
    let p5: int *stack = p4; // OK
}

fun i() {
    let i_stack: int;

    // Chain of assignments of pointers to stack lifetime
    // Each variable declares a lifetime that we should solve to equal *stack.
    let p1: int *a = i_stack.&;
    let p2: int *b = p1;
    let p3: int *c = p2;
    let p4: int *d = p3;

    // Assignment leaks address of i_stack into static memory
    let p5: int *static = p4; // E-L_ESC_STACK
}