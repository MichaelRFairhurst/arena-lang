fun take_static(p: int *static);
fun ret_static() -> int *static;

fun call_funcs_ok() {
    // Passing *static to *static -- ok
    let p1: int *static = ret_static(); // OK
    take_static(p1); // OK
}

fun call_funcs_bad() {
    let p1: int *stack;

    // Passing *stack to *static
    take_static(p1); // E-L_ESC_STACK
}