fun isolated_bad() {
    let outer: int *stack;
    {
        let inner: int *stack;

        // *stack<outer> lives longer than *stack<inner>, so not allowed.
        outer = inner; // E-L_ESC_BLOCK
    }
}

fun isolated_ok() {
    let outer: int *stack;
    {
        let inner: int *stack;

        // *stack<outer> lives longer than *stack<inner>, so this is allowed.
        inner = outer; // OK
    }
}

fun mixed() {
    // Mix the above two tests into one set of constraints to solve.

    let outer: int *stack;
    {
        let inner: int *stack;

        outer = inner; // E-L_ESC_BLOCK
        inner = outer; // OK
    }
}