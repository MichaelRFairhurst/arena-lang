fun putchar(c: int);
fun puts(c: char const*);
fun printf(c: char const*);

fun print_space() {
    let space = 32;
    putchar(space);
}

fun print_newline() {
    let newline = 10;
    putchar(newline);
}

fun print_uint(x: uint) {
    let zero: uint = 48;

    let rem = x % 10;
    let div = x / 10;
    let digit = zero + rem;

    if (div != 0) {
        print_uint(div);
    }

    putchar(digit.as(int));
}

fun print_int(x: int) -> void {
    if (x < 0) {
        x = -x;
        let dash = 45;
        putchar(dash);
    }
    
    print_uint(x.as(uint));
}