fun f() {
    let p_outer: int *arena;

    arena {
        let p_inner: int *arena;

        // nested arena value escapes its arena
        p_outer = p_inner; // E-L_ESC_RNA
    }
}

fun g() {
    let p_outer: int *arena;

    arena {
        let p_inner: int *arena;

        // int* is not lifetime strict and may be cast to inner arena lifetime
        p_inner = p_outer; // OK
    }
}

fun h() {
    let p_outer: int *arena;

    {
        let p_inner: int *arena;

        // Nested block is not an arena block, so arena lifetimes match.
        p_outer = p_inner; // OK
    }
}