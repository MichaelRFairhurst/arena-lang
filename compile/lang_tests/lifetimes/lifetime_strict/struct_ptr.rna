struct SomeStruct;

fun f(p1: SomeStruct *arena) {
    let p2: SomeStruct *stack;

    // SomeStruct is an incomplete type, so lifetimes must exactly match.
    p2 = p1; // E-L_ESC_STACK
}

fun g(p1: SomeStruct *arena, p2: SomeStruct *arena) {
    // Lifetimes exactly match
    p2 = p1; // OK
    p1 = p2; // OK
}