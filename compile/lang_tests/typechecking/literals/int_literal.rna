    let s2: short = 10;
    let s3: short = 32767;
    let s4: short = 32768; // E-T_LIT_OOR
    // let s5: short = -32768;
    // let s5: short = -32769; // E-T_LIT_OOR
    let us1: ushort = 0;
    let us2: ushort = 10;
    let us3: ushort = 65535;
    let us4: ushort = 65536; // E-T_LIT_OOR
    // let us5: ushort = -1; // E-T_LIT_OOR
    let l1: long = 0;
    let l2: long = 10;
    let l3: long = 9'223'372'036'854'775'807;
    let l4: long = 9'223'372'036'854'775'808; // E-T_LIT_OOR
    // let l5: long = -9'223'372'036'854'775'808;
    // let l6: long = -9'223'372'036'854'775'809; // E-T_LIT_OOR
    let ul1: ulong = 0;
    let ul2: ulong = 10;
    let ul3: ulong = 18'446'744'073'709'551'615;
    let ul4: ulong = 18'446'744'073'709'551'616; // E-T_LIT_OOR
    // let ul5: ulong = -1; // E-T_LIT_OOR
    let z1: ssize = 0;
    let z2: ssize = 10;
    let z3: ssize = 9'223'372'036'854'775'807;
    let z4: ssize = 9'223'372'036'854'775'808; // E-T_LIT_OOR
    // let z5: ssize = -9'223'372'036'854'775'808;
    // let z6: ssize = -9'223'372'036'854'775'809; // E-T_LIT_OOR
    let uz1: usize = 0;
    let uz2: usize = 10;
    let uz3: usize = 18'446'744'073'709'551'615;
    let uz4: usize = 18'446'744'073'709'551'616; // E-T_LIT_OOR
    // let uz5: usize = -1; // E-T_LIT_OOR
}